[Unit]
Description=Pip brain (reflex rules + tiny_agent judgment)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/pip-brain/pip-brain --pip http://192.168.1.110 --listen-port 8080 --llm http://pi5.local:8081 --model Qwen2.5-3B-Instruct
Restart=always
RestartSec=3
Environment=HOME=%h

[Install]
WantedBy=default.target

[Unit]
Description=Pip voice (Piper TTS to 16 kHz PCM) on the Pi 5
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/pip-voice
Environment=PYTHONUNBUFFERED=1
Environment=PIP_PIPER_VOICE=%h/pip-probe/voices/en_US-lessac-medium.onnx
Environment=PIP_VOICE_RATE=1.12
Environment=PIP_PIPER_LENGTH_SCALE=1.0
ExecStart=%h/pip-probe/venv/bin/python -m uvicorn voice:app --host 0.0.0.0 --port 8091
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

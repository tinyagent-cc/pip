[Unit]
Description=Pip Jetson text LLM (model from ~/.config/pip/llama-text.env, CUDA)
After=network-online.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=%h/tools/llama.cpp/build/bin
Environment=PATH=/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
# Defaults; ~/.config/pip/llama-text.env (written by pip-llm) overrides them.
Environment=LLAMA_MODEL=%h/models/Qwen2.5-3B-Instruct-Q4_K_M.gguf
Environment=LLAMA_EXTRA=
EnvironmentFile=-%h/.config/pip/llama-text.env
ExecStart=%h/tools/llama.cpp/build/bin/llama-server \
  -m ${LLAMA_MODEL} \
  --host 0.0.0.0 --port 8081 \
  -ngl 99 -c 4096 --jinja -t 4 $LLAMA_EXTRA
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

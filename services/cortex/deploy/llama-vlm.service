[Unit]
Description=Pip Jetson VLM (model from ~/.config/pip/llama-vlm.env, CUDA)
After=network-online.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=%h/tools/llama.cpp/build/bin
Environment=PATH=/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
Environment=VLM_MODEL=%h/models/qwen3-vl-2b/Qwen3-VL-2B-Instruct-Q4_K_M.gguf
# Q8_0 mmproj (445 MB) over F16 (819 MB): same eyes, and the saved RAM is what
# lets the rest of the box breathe. ~/.config/pip/llama-vlm.env overrides.
Environment=VLM_MMPROJ=%h/models/qwen3-vl-2b/mmproj-Q8_0.gguf
EnvironmentFile=-%h/.config/pip/llama-vlm.env
ExecStart=%h/tools/llama.cpp/build/bin/llama-server \
  -m ${VLM_MODEL} \
  --mmproj ${VLM_MMPROJ} \
  --host 0.0.0.0 --port 8082 \
  -c 2048 -t 2 $VLM_EXTRA
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

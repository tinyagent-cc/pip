[Unit]
Description=Pip Jetson VLM (SmolVLM-500M-Instruct Q8_0 + f16 mmproj, CUDA)
After=network-online.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=%h/tools/llama.cpp/build/bin
Environment=PATH=/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/tools/llama.cpp/build/bin/llama-server \
  -m %h/models/smolvlm/SmolVLM-500M-Instruct-Q8_0.gguf \
  --mmproj %h/models/smolvlm/mmproj-SmolVLM-500M-Instruct-f16.gguf \
  --host 0.0.0.0 --port 8082 \
  -ngl 99 -c 2048 -t 2
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
